#!/bin/sh
# Enforces Conventional Commits and forbids AI/co-author trailers.
# Usage: commit-msg <msg-file>
msg_file="$1"

die() { echo "commit-msg: $1" >&2; exit 1; }

# First non-comment, non-empty line is the header.
header=$(grep -v '^#' "$msg_file" | sed -n '/./{p;q;}')

case "$header" in
  "Merge "*) exit 0 ;;
esac

[ -n "$header" ] || die "empty commit message"

[ "${#header}" -le 72 ] || die "header longer than 72 characters"

printf '%s\n' "$header" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?: [a-z0-9]' \
  || die "header must be '<type>(<scope>): <lowercase subject>' with type in feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

case "$header" in
  *.) die "subject must not end with a period" ;;
esac

if grep -v '^#' "$msg_file" | grep -Eiq '^[[:space:]]*co-authored-by:|generated (with|by)[^.]*(claude|anthropic|\bai\b)|noreply@anthropic\.com'; then
  die "co-author / AI attribution trailers are not allowed"
fi

exit 0
