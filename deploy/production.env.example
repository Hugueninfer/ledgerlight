# Copy to /opt/ledgerlight/.env on the VM (chmod 600). Never commit the real file.
# Generate APP_KEY with:  echo "base64:$(openssl rand -base64 32)"
# Generate passwords with: openssl rand -hex 24

APP_DOMAIN=your-subdomain.duckdns.org

APP_NAME=Ledgerlight
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-subdomain.duckdns.org

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=ledgerlight
DB_USERNAME=ledgerlight
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
